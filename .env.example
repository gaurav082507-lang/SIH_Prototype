# Copy to .env for local runs. On Render, set these under
# Dashboard -> your service -> Environment instead of committing a .env file.

# Required — planner + final-assessment LLM calls
GROQ_API_KEY=

# Optional — only needed if you re-enable planner_agent.py (not wired into
# graph.py by default; planner_node.py uses Groq only)
MISTRAL_API_KEY=

# Backend data services (safe defaults already point at the ORCA services;
# override only if you're running your own)
CYCLONE_API_BASE_URL=https://orca-backend-gkvo.onrender.com/api/cyclone
TIDE_API_URL=https://orca-backend-tide.onrender.com/tide
GIS_API_URL=https://orca-backend-gis.onrender.com/api/gis

# CORS — "*" is fine when the frontend is served by this same service
ALLOWED_ORIGINS=*
